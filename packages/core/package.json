{
  "name": "@mcp-capagate/core",
  "version": "0.1.0",
  "description": "Core capability graph, policy compiler, scanners, proxy, and reporting engine for MCP CapaGate.",
  "author": "MCP CapaGate contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choose-hy/mcp-capagate.git",
    "directory": "packages/core"
  },
  "keywords": [
    "mcp",
    "capability-graph",
    "policy-compiler",
    "agent-security"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
